# ------------------------------------
# Herdr friendly config
# ------------------------------------
# Herdr (the multiplexer) owns cmd+h/l/j/k/t/w/n:
#   cmd+h / cmd+l  -> previous / next tab
#   cmd+j / cmd+k  -> previous / next workspace
#   cmd+t          -> new tab
#   cmd+w          -> close tab
#   cmd+n          -> new workspace
# Ghostty must not consume those keys, so the old tmux passthroughs are
# gone and the ghostty defaults that would steal them are unbound.
# NOTE: no trailing comments on keybind lines, ghostty mis-parses them.

# (cmd+b for ghostty)
keybind = global:ctrl+alt+t=new_window

# Free herdr keys from ghostty defaults
#   super+j = scroll_to_selection
#   super+k = clear_screen
#   super+t = new_tab
#   super+w = close_surface
#   super+n = new_window
keybind = super+j=unbind
keybind = super+k=unbind
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+n=unbind

# Free keys added to herdr later (cmd+z, cmd+shift+w, cmd+shift+j)
#   super+z           default: undo (also the Undo menu item)
#   super+shift+w     default: close_window
#   super+shift+j     default: write_screen_file:paste,plain
keybind = super+z=unbind
keybind = super+shift+w=unbind
keybind = super+shift+j=unbind
keybind = super+shift+t=unbind
# cmd+h: not a ghostty binding, but the macOS menu "Hide Ghostty" owns it.
# Remap it in System Settings -> Keyboard -> Keyboard Shortcuts -> App
# Shortcuts (e.g. ctrl+cmd+h), otherwise herdr never sees cmd+h.
